timeout -1

default /default
gfxmenu /GFX/yellow.gz
font /GFX/unifont.hex.gz
graphicsmode -1 100:1000 100:10000 24:32

title Suse
partnew (%@root:~1,3%,3) 0x00 /TUX/suse.iso
map /TUX/suse.iso (0xff)
map --hook
root (0xff)
chainloader (0xff)

title Kali
partnew (%@root:~1,3%,3) 0x00 /TUX/kali.iso
map /TUX/kali.iso (0xff)
map --hook
root (0xff)
chainloader (0xff)

title Parrot
partnew (%@root:~1,3%,3) 0x00 /TUX/parrot.iso
map /TUX/parrot.iso (0xff)
map --hook
root (0xff)
chainloader (0xff)

title Debian
partnew (%@root:~1,3%,3) 0x00 /TUX/debian.iso
map /TUX/debian.iso (0xff)
map --hook
root (0xff)
chainloader (0xff)

title Alpine
partnew (%@root:~1,3%,3) 0x00 /TUX/alpine.iso
map /TUX/alpine.iso (0xff)
map --hook
root (0xff)
chainloader (0xff)

title 
clear

title Macrium
map --mem /PE/macrium.iso (hd32)
map --hook
chainloader (hd32)/bootmgr

title Aomei Partition
map --mem /PE/aomei.iso (hd32)
map --hook
chainloader (hd32)/bootmgr

title 
clear

title Win 10
map --mem (md)+4 (9)
map /ISO/w10_64.iso (0xff)
map (hd0) (hd1)
map (hd1) (hd0)
map --rehook
write (9) [FiraDisk]\nStartOptions=cdrom,vmem=find:/ISO/w10_64.iso;\n\0
chainloader (0xff)/bootmgr

title Win 11 
map --mem (md)+4 (9)
map /ISO/w11.iso (0xff)
map (hd0) (hd1)
map (hd1) (hd0)
map --rehook
write (9) [FiraDisk]\nStartOptions=cdrom,vmem=find:/ISO/w11.iso;\n\0
chainloader (0xff)/bootmgr

title 
clear

title Reboot
reboot

title Shutdown
halt
